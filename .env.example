# Honeypot configuration
# Copy this file to .env and change what you need. Every line is optional:
# anything you leave out uses the default shown here.
# Relative paths are inside the project folder.

# --- HTTP decoy (fake "Acme Corp" login portal) ---
HTTP_DECOY_ENABLED=true
HTTP_PORT=8080
HTTP_HOST=0.0.0.0
# Only set true if the honeypot is behind YOUR reverse proxy (otherwise attackers can fake their IP)
TRUST_PROXY_HEADERS=false

# --- SSH decoy (fake Ubuntu server) ---
SSH_DECOY_ENABLED=true
SSH_PORT=2222
SSH_HOST=0.0.0.0
SSH_HOST_KEY_PATH=data/ssh_host_rsa_key
# Weak user:password pairs that "work" so attackers reach the fake shell.
# All other passwords are rejected. Every attempt is logged either way.
SSH_ACCEPTED_CREDENTIALS=root:root,root:toor,root:123456,root:password,root:admin,admin:admin,admin:password,admin:123456,ubuntu:ubuntu,user:user,test:test,guest:guest,pi:raspberry,oracle:oracle

# --- Database ---
DATABASE_PATH=data/honeypot.db

# --- Session limits (HTTP + SSH together) ---
MAX_CONCURRENT_SESSIONS=100
SESSION_IDLE_TIMEOUT_SECONDS=300
SESSION_MAX_DURATION_SECONDS=1800
# Longest fake command output, in bytes
MAX_OUTPUT_BYTES=4096

# --- Rate limiting: connections from one IP beyond this are answered but not logged ---
RATE_LIMIT_PER_IP=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- IP enrichment (download with scripts/setup_geoip.sh; works offline without them) ---
GEOIP_DB_PATH=data/GeoLite2-City.mmdb
GEOIP_ASN_DB_PATH=data/GeoLite2-ASN.mmdb
IP_INTEL_CACHE_HOURS=24

# --- Dashboard ---
# true = start it together with the decoys (python -m app.main)
DASHBOARD_ENABLED=false
# On a Mac, port 5000 is used by AirPlay Receiver - use 5050 instead
DASHBOARD_PORT=5000
# Keep 127.0.0.1: the dashboard has no login
DASHBOARD_HOST=127.0.0.1

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=data/logs/honeypot.log

# --- Deployment ---
# Name of the normal (non-root) user you run the honeypot as; shown in the warning if you run as root
RUN_AS_USER=honeypot
